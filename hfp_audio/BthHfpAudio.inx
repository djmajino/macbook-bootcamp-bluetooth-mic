[Version]
Signature="$Windows NT$"
Class=MEDIA
Provider=%ProviderName%
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer=08/27/2026,0.1.0.0
CatalogFile=BthHfpAudio.cat
PnpLockDown=1

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
BthHfpAudio.sys=1

[DestinationDirs]
HFP.CopyList=13

[Manufacturer]
%MfgName%=Models,NTamd64.10.0...18362

[Models.NTamd64.10.0...18362]
%DeviceDesc%=HFP,Root\BthHfpAudio

[HFP.CopyList]
BthHfpAudio.sys

[HFP.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,BthHfpAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%MidiDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%
; Prevent the unmodified SysVAD capture simulator from producing a test tone.
HKR,Parameters,DisableToneGenerator,0x00010001,1
HKR,Parameters,DoNotCreateDataFiles,0x00010001,1

[HFP.I.WaveBthHfpSpeaker]
AddReg=HFP.I.WaveBthHfpSpeaker.AddReg

[HFP.I.WaveBthHfpSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveSpeakerName%

[HFP.I.TopologyBthHfpSpeaker]
AddReg=HFP.I.TopologyBthHfpSpeaker.AddReg

[HFP.I.TopologyBthHfpSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologySpeakerName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[HFP.I.WaveBthHfpMic]
AddReg=HFP.I.WaveBthHfpMic.AddReg

[HFP.I.WaveBthHfpMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveMicName%

[HFP.I.TopologyBthHfpMic]
AddReg=HFP.I.TopologyBthHfpMic.AddReg

[HFP.I.TopologyBthHfpMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyMicName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[HFP.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=HFP.CopyList
AddReg=HFP.AddReg

[HFP.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveBthHfpSpeaker%,HFP.I.WaveBthHfpSpeaker
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveBthHfpSpeaker%,HFP.I.WaveBthHfpSpeaker
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveBthHfpSpeaker%,HFP.I.WaveBthHfpSpeaker
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyBthHfpSpeaker%,HFP.I.TopologyBthHfpSpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyBthHfpSpeaker%,HFP.I.TopologyBthHfpSpeaker
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveBthHfpMic%,HFP.I.WaveBthHfpMic
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveBthHfpMic%,HFP.I.WaveBthHfpMic
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveBthHfpMic%,HFP.I.WaveBthHfpMic
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyBthHfpMic%,HFP.I.TopologyBthHfpMic
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyBthHfpMic%,HFP.I.TopologyBthHfpMic

[HFP.NT.Services]
AddService=BthHfpAudio,0x00000002,HFP.Service

[HFP.Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\BthHfpAudio.sys

[HFP.NT.HW]
AddReg=HFP.HW.AddReg

[HFP.HW.AddReg]
HKR,,DeviceType,0x00010001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[HFP.NT.Wdf]
KmdfService=BthHfpAudio,HFP.Wdf

[HFP.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="BthHfpAudio experiment"
MfgName="BthHfpAudio experiment"
DiskName="BthHfpAudio installation media"
DeviceDesc="Bluetooth HFP Sideband Audio (experimental)"
ServiceDesc="Bluetooth HFP Sideband Audio Driver (experimental)"
MidiDesc="Bluetooth HFP MIDI placeholder"

KSNAME_WaveBthHfpSpeaker="WaveBthHfpSpeaker"
KSNAME_TopologyBthHfpSpeaker="TopologyBthHfpSpeaker"
KSNAME_WaveBthHfpMic="WaveBthHfpMic"
KSNAME_TopologyBthHfpMic="TopologyBthHfpMic"

WaveSpeakerName="Bluetooth HFP Speaker Wave"
TopologySpeakerName="Bluetooth HFP Speaker Topology"
WaveMicName="Bluetooth HFP Microphone Wave"
TopologyMicName="Bluetooth HFP Microphone Topology"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
